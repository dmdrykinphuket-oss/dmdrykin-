# Скопируйте этот файл в .env и впишите свои значения.

# Токен Telegram-бота — получите у @BotFather в Telegram.
TELEGRAM_TOKEN=сюда_вставьте_токен_от_BotFather

# Ключ Anthropic API — возьмите на https://console.anthropic.com/ (раздел API Keys).
ANTHROPIC_API_KEY=сюда_вставьте_ключ_Anthropic

# Список Telegram ID пользователей, которым разрешено пользоваться ботом.
# Через запятую. Свой ID можно узнать у бота @userinfobot.
# Пример: ALLOWED_USERS=123456789,987654321
ALLOWED_USERS=123456789
