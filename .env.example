# Скопируйте этот файл в .env и впишите свои значения.

# Токен Telegram-бота — получите у @BotFather в Telegram.
TELEGRAM_TOKEN=сюда_вставьте_токен_от_BotFather

# Ключ Anthropic API — возьмите на https://console.anthropic.com/ (раздел API Keys).
ANTHROPIC_API_KEY=сюда_вставьте_ключ_Anthropic

# Ключ OpenAI API — возьмите на https://platform.openai.com/api-keys.
# Используется для расшифровки голосовых через OpenAI Whisper API (модель
# whisper-1). Необязательный: если не задан или API вернёт ошибку, бот
# автоматически переключится на локальную модель faster-whisper.
OPENAI_API_KEY=сюда_вставьте_ключ_OpenAI

# Список Telegram ID пользователей, которым разрешено пользоваться ботом.
# Через запятую. Свой ID можно узнать у бота @userinfobot.
# Пример: ALLOWED_USERS=123456789,987654321
ALLOWED_USERS=123456789

# --- ClickUp (необязательно) ---
# Личный токен ClickUp API. Возьмите в ClickUp: Settings → Apps → API Token
# (строка вида pk_...). Передаётся в заголовке Authorization.
# Нужны обе переменные ниже — иначе инструменты работы с задачами отключаются.
CLICKUP_TOKEN=сюда_вставьте_токен_ClickUp

# ID списка ClickUp, в котором бот создаёт задачи по умолчанию. Проще всего
# взять из URL списка: .../li/<CLICKUP_LIST_ID> (число).
CLICKUP_LIST_ID=сюда_вставьте_ID_списка
